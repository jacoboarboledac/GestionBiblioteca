<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="your.package.CrudController">
    <children>
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Label text="Interfaz CRUD en JavaFX" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </HBox>

        <!-- Tabla para mostrar los datos (Read) -->
        <TableView fx:id="tableView" prefHeight="300.0" prefWidth="600.0">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="nameColumn" prefWidth="150.0" text="Nombre" />
                <TableColumn fx:id="emailColumn" prefWidth="200.0" text="Email" />
                <TableColumn fx:id="actionsColumn" prefWidth="100.0" text="Acciones" />
            </columns>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </TableView>

        <!-- Formulario para Create/Update -->
        <GridPane hgap="10.0" vgap="10.0">
            <children>
                <Label text="ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="idField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="nameField" promptText="Ingrese el nombre" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="emailField" promptText="Ingrese el email" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </children>
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </GridPane>

        <!-- Botones para CRUD -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Button fx:id="addButton" mnemonicParsing="false" onAction="#handleAdd" text="Agregar (Create)" />
                <Button fx:id="updateButton" mnemonicParsing="false" onAction="#handleUpdate" text="Actualizar (Update)" />
                <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#handleDelete" text="Eliminar (Delete)" />
                <Button fx:id="clearButton" mnemonicParsing="false" onAction="#handleClear" text="Limpiar" />
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </HBox>
    </children>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</VBox>

